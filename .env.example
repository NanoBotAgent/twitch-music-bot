# Twitch Music Bot - Environment Variables

# Copy this file to .env and fill in your values

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_PASSWORD=changeme

# ============================================
# Twitch OAuth (Required)
# ============================================
# Create at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_BOT_OAUTH_TOKEN=oauth:your_bot_token
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_REDIRECT_URI=https://your-domain.com/auth/twitch/callback

# ============================================
# Spotify OAuth (Required for Spotify features)
# ============================================
# Create at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://your-domain.com/auth/spotify/callback

# ============================================
# SoundCloud OAuth (Required for SoundCloud features)
# ============================================
# Create at https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id

# ============================================
# Security (Required)
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_32_byte_jwt_secret_here
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# ============================================
# Frontend URL (Required for OAuth redirects)
# ============================================
FRONTEND_URL=https://your-domain.vercel.app

# ============================================
# Optional: YouTube (yt-dlp fallback)
# ============================================
# YTDLP_PATH=/usr/local/bin/yt-dlp